# Next.js Environment Variables

# Worker URL (development uses local worker, production uses deployed worker)
NEXT_PUBLIC_WORKER_URL=http://localhost:8787

# Database URL (for local development with SQLite)
DATABASE_URL=file:./dev.db

# Better Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long-please-change-this
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Optional - only needed if you want Google login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudflare D1 Database
# These are configured in wrangler.toml for the worker
# DB binding name: DB
# Database: alphland-bounty
# Database ID: 8c5941e7-d2ff-4d89-b44c-660127cce177
